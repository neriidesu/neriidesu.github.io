---
interface Props {
    title: string
    description: string
    url: string
}

const {title, description, url} = Astro.props
---

<div class="container">
    <h3><a href={url}>{title}</a></h3>
    <p>{description}</p>
</div>

<style lang="scss">
  $surface: #271d1b;

    .container {
        h3 {
            margin: 0px
        }
        p {
            margin: 0px;
            text-align: left;
        }
        padding: 10px;
        margin:10px;
        border:1px solid $surface;
    }
</style>

